#
# Starts Postgres and the backend, opens the browser on /metadata once it's
# ready. Defaults to port 8087, not the backend's own 8080 default - cAdvisor
# (container monitoring) commonly squats 8080 on a dev machine that also runs
# Prometheus/Grafana. Override with HFS_SERVER_PORT if you need to.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

export HFS_SERVER_PORT="${HFS_SERVER_PORT:-8087}"
URL="http://127.0.0.1:${HFS_SERVER_PORT}/metadata"

docker compose up -d

(
    for _ in $(seq 1 60); do
        if curl -sf -o /dev/null "$URL"; then
            xdg-open "$URL" >/dev/null 2>&1 || open "$URL" >/dev/null 2>&1 || true
            break
        fi
        sleep 1
    done
) &

exec cargo run -p openpas-backend
