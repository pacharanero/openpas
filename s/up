#
# Starts Postgres, the FHIR backend, and the web UI; opens the browser on
# the login page once it's ready. Ctrl-C stops both Rust processes - though
# `cargo run` is known not to always forward signals cleanly to the actual
# binary it spawns; `pkill -f target/debug/openpas` if anything lingers.
#
# Backend defaults to port 8087, not its own 8080 default - cAdvisor
# (container monitoring) commonly squats 8080 on a dev machine that also
# runs Prometheus/Grafana. Override with HFS_SERVER_PORT if you need to.
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

export HFS_SERVER_PORT="${HFS_SERVER_PORT:-8087}"
export OPENPAS_BACKEND_URL="${OPENPAS_BACKEND_URL:-http://127.0.0.1:${HFS_SERVER_PORT}}"
export OPENPAS_WEB_PORT="${OPENPAS_WEB_PORT:-8089}"
URL="http://127.0.0.1:${OPENPAS_WEB_PORT}/login"

docker compose up -d

cargo run -p openpas-backend &
BACKEND_PID=$!
trap 'kill "$BACKEND_PID" 2>/dev/null' EXIT

(
    for _ in $(seq 1 60); do
        if curl -sf -o /dev/null "$URL"; then
            xdg-open "$URL" >/dev/null 2>&1 || open "$URL" >/dev/null 2>&1 || true
            break
        fi
        sleep 1
    done
) &

cargo run -p openpas-web
